{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://creators-common.org/schemas/contribution-record.schema.json",
  "title": "Creators Common Contribution Record",
  "description": "A controlled record of a contributor's specific work, evidence, review status, attribution and agreed rights in relation to a registered creation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contributionId",
    "recordVersion",
    "creationId",
    "contributorId",
    "role",
    "description",
    "status",
    "attribution",
    "review",
    "issuer",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.1.0"
    },
    "contributionId": {
      "type": "string",
      "pattern": "^CC-CO-[A-Z0-9][A-Z0-9._-]{5,95}$"
    },
    "recordVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"
    },
    "creationId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    },
    "creationVersionRef": {
      "type": "string",
      "maxLength": 200
    },
    "contributorId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    },
    "contributorDisplayName": {
      "type": "string",
      "maxLength": 240
    },
    "role": {
      "type": "string",
      "enum": [
        "originating-creator",
        "co-creator",
        "design-contributor",
        "engineering-contributor",
        "research-contributor",
        "software-contributor",
        "manufacturing-contributor",
        "validation-authority",
        "domain-reviewer",
        "institutional-sponsor",
        "funding-sponsor",
        "custodian",
        "commercial-operator",
        "improvement-creator",
        "derivative-creator",
        "other"
      ]
    },
    "customRole": {
      "type": "string",
      "maxLength": 160
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 10000
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workPackage": {"type": "string", "maxLength": 240},
        "componentRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 300}
        },
        "deliverableRefs": {"$ref": "#/$defs/references"},
        "excludedScope": {"type": "string", "maxLength": 5000}
      }
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startedOn": {"type": "string", "format": "date"},
        "completedOn": {"type": "string", "format": "date"},
        "recordedAt": {"type": "string", "format": "date-time"}
      }
    },
    "evidenceRefs": {"$ref": "#/$defs/references"},
    "dependencies": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "ref"],
        "properties": {
          "type": {"type": "string", "enum": ["prior-creation", "prior-contribution", "source-material", "tool", "dataset", "standard", "other"]},
          "ref": {"type": "string", "minLength": 1, "maxLength": 1000},
          "description": {"type": "string", "maxLength": 2000}
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["draft", "submitted", "under-review", "accepted", "partially-accepted", "rejected", "disputed", "withdrawn", "superseded"]
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["creditName", "creditStatus"],
      "properties": {
        "creditName": {"type": "string", "minLength": 1, "maxLength": 240},
        "creditStatement": {"type": "string", "maxLength": 3000},
        "creditStatus": {"type": "string", "enum": ["accepted", "pending", "disputed", "declined", "withdrawn"]},
        "publicCredit": {"type": "boolean", "default": true},
        "citationPreference": {"type": "string", "maxLength": 1000}
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agreementRef": {"$ref": "#/$defs/reference"},
        "ownershipClaimed": {"type": "boolean"},
        "assignmentStatus": {"type": "string", "enum": ["not-applicable", "not-assigned", "partially-assigned", "assigned", "disputed", "unknown"]},
        "licenceGrantRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 3, "maxLength": 200}
        },
        "economicEntitlementRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 3, "maxLength": 200}
        },
        "moralRightsPosition": {"type": "string", "maxLength": 3000},
        "notes": {"type": "string", "maxLength": 3000}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"type": "string", "enum": ["not-started", "in-progress", "accepted", "partially-accepted", "rejected", "disputed"]},
        "reviewerIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 3, "maxLength": 200}
        },
        "reviewedAt": {"type": "string", "format": "date-time"},
        "decisionRef": {"$ref": "#/$defs/reference"},
        "findings": {"type": "string", "maxLength": 5000},
        "requiredCorrections": {"type": "string", "maxLength": 5000}
      }
    },
    "confidentiality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {"$ref": "#/$defs/visibility"},
        "basisRef": {"type": "string", "maxLength": 1000},
        "embargoUntil": {"type": "string", "format": "date-time"},
        "restrictedFields": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 160}
        }
      }
    },
    "dispute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "active": {"type": "boolean"},
        "caseRef": {"type": "string", "maxLength": 1000},
        "summary": {"type": "string", "maxLength": 5000},
        "interimTreatment": {"type": "string", "maxLength": 3000}
      }
    },
    "issuer": {"$ref": "#/$defs/issuer"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"role": {"const": "other"}},
        "required": ["role"]
      },
      "then": {
        "required": ["customRole"]
      }
    }
  ],
  "$defs": {
    "visibility": {
      "type": "string",
      "enum": ["public", "member", "restricted", "confidential"]
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref"],
      "properties": {
        "ref": {"type": "string", "minLength": 1, "maxLength": 1000},
        "label": {"type": "string", "maxLength": 240},
        "hash": {"type": "string", "maxLength": 256},
        "mediaType": {"type": "string", "maxLength": 120},
        "visibility": {"$ref": "#/$defs/visibility"}
      }
    },
    "references": {
      "type": "array",
      "maxItems": 2000,
      "items": {"$ref": "#/$defs/reference"}
    },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuerId", "name"],
      "properties": {
        "issuerId": {"type": "string", "minLength": 3, "maxLength": 200},
        "name": {"type": "string", "minLength": 1, "maxLength": 240},
        "authorityRef": {"type": "string", "maxLength": 500}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "previousVersionRef": {"type": "string", "maxLength": 500},
        "sourceRecordRefs": {"$ref": "#/$defs/references"},
        "contentHash": {"type": "string", "maxLength": 256},
        "signatureRef": {"type": "string", "maxLength": 1000},
        "changeReason": {"type": "string", "maxLength": 3000}
      }
    }
  }
}
