{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://creators-common.org/schemas/process-recipe.schema.json",
  "title": "Creators Common Process Recipe",
  "description": "Ordered production, laboratory, computational or assembly recipe for an Asset Draft.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "processRecipeId", "recordVersion", "assetDraftId", "name", "steps", "status", "issuer", "createdAt", "updatedAt"],
  "properties": {
    "schemaVersion": {"type": "string", "const": "0.1.0"},
    "processRecipeId": {"type": "string", "pattern": "^CC-PR-[A-Z0-9][A-Z0-9._-]{5,95}$"},
    "recordVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"},
    "assetDraftId": {"type": "string", "minLength": 3, "maxLength": 200},
    "name": {"type": "string", "minLength": 1, "maxLength": 300},
    "description": {"type": "string", "maxLength": 5000},
    "inputRefs": {"$ref": "#/$defs/idList"},
    "steps": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"type": "object", "additionalProperties": false, "required": ["sequence", "action"], "properties": {"sequence": {"type": "integer", "minimum": 1}, "action": {"type": "string", "minLength": 3, "maxLength": 1000}, "equipmentRef": {"type": "string", "maxLength": 300}, "operatorRole": {"type": "string", "maxLength": 200}, "parameters": {"type": "array", "maxItems": 200, "items": {"type": "object", "additionalProperties": false, "required": ["name", "value"], "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 160}, "value": {"type": "string", "minLength": 1, "maxLength": 160}, "unit": {"type": "string", "maxLength": 80}, "tolerance": {"type": "string", "maxLength": 120}}}}, "inspectionPointRefs": {"$ref": "#/$defs/references"}, "evidenceRefs": {"$ref": "#/$defs/references"}}}},
    "outputRefs": {"$ref": "#/$defs/idList"},
    "wasteOutputs": {"type": "array", "maxItems": 500, "items": {"type": "object", "additionalProperties": false, "required": ["name", "route"], "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 240}, "estimatedQuantity": {"type": "string", "maxLength": 120}, "unit": {"type": "string", "maxLength": 80}, "route": {"type": "string", "enum": ["reuse", "recycle", "recover", "treat", "dispose", "unknown"]}, "evidenceRefs": {"$ref": "#/$defs/references"}}}},
    "applicableStandardRefs": {"$ref": "#/$defs/references"},
    "status": {"type": "string", "enum": ["draft", "proposed", "verified", "validated", "approved", "restricted", "deprecated", "superseded"]},
    "issuer": {"$ref": "#/$defs/issuer"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "idList": {"type": "array", "uniqueItems": true, "maxItems": 5000, "items": {"type": "string", "minLength": 3, "maxLength": 200}},
    "reference": {"type": "object", "additionalProperties": false, "required": ["ref"], "properties": {"ref": {"type": "string", "minLength": 1, "maxLength": 1000}, "label": {"type": "string", "maxLength": 240}, "hash": {"type": "string", "maxLength": 256}, "mediaType": {"type": "string", "maxLength": 120}, "visibility": {"type": "string", "enum": ["public", "member", "restricted", "confidential"]}}},
    "references": {"type": "array", "maxItems": 2000, "items": {"$ref": "#/$defs/reference"}},
    "issuer": {"type": "object", "additionalProperties": false, "required": ["issuerId", "name"], "properties": {"issuerId": {"type": "string", "minLength": 3, "maxLength": 200}, "name": {"type": "string", "minLength": 1, "maxLength": 240}, "authorityRef": {"type": "string", "maxLength": 500}}},
    "provenance": {"type": "object", "additionalProperties": false, "properties": {"previousVersionRef": {"type": "string", "maxLength": 500}, "sourceRecordRefs": {"$ref": "#/$defs/references"}, "changeReason": {"type": "string", "maxLength": 3000}}}
  }
}
