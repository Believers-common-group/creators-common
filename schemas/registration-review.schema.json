{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://creators-common.org/schemas/registration-review.schema.json",
  "title": "Creators Common Registration Review",
  "description": "Human and Warden-governed review record for Creator and Creation registration applications.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reviewId",
    "recordVersion",
    "applicationRef",
    "applicationType",
    "reviewStage",
    "reviewer",
    "humanReviewed",
    "evidenceSufficiency",
    "permissionCheck",
    "publicVisibilityCheck",
    "disposition",
    "reasonCodes",
    "reviewedAt",
    "issuer"
  ],
  "properties": {
    "schemaVersion": {"type": "string", "const": "0.1.0"},
    "reviewId": {"type": "string", "pattern": "^CC-REG-RV-[A-Z0-9][A-Z0-9._-]{5,95}$"},
    "recordVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"},
    "applicationRef": {"type": "string", "minLength": 3, "maxLength": 200},
    "applicationType": {"type": "string", "enum": ["creator", "creation"]},
    "reviewStage": {"type": "string", "enum": ["identity", "consent", "evidence", "authorship", "ownership", "safety", "regulatory", "publication", "final"]},
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewerRef", "role", "institutionRef"],
      "properties": {
        "reviewerRef": {"type": "string", "minLength": 3, "maxLength": 200},
        "role": {"type": "string", "enum": ["identity-reviewer", "domain-reviewer", "rights-reviewer", "safety-reviewer", "registration-authority", "warden-reviewer"]},
        "institutionRef": {"type": "string", "minLength": 3, "maxLength": 200}
      }
    },
    "humanReviewed": {"type": "boolean"},
    "evidenceSufficiency": {"type": "string", "enum": ["insufficient", "partial", "sufficient", "not-applicable"]},
    "permissionCheck": {"type": "string", "enum": ["failed", "conditional", "passed", "not-applicable"]},
    "publicVisibilityCheck": {"type": "string", "enum": ["blocked", "restricted", "member-only", "public-eligible", "not-requested"]},
    "findings": {"type": "array", "maxItems": 500, "items": {"type": "string", "minLength": 1, "maxLength": 3000}},
    "requiredActions": {"type": "array", "maxItems": 200, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
    "disposition": {"type": "string", "enum": ["pending", "return-for-information", "recommend-accept", "recommend-reject", "accepted", "rejected", "abstain"]},
    "reasonCodes": {"type": "array", "minItems": 1, "uniqueItems": true, "maxItems": 100, "items": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{1,95}$"}},
    "wardenDecisionRef": {"type": "string", "maxLength": 200},
    "riverosEvidenceEventRef": {"type": "string", "maxLength": 200},
    "reviewedAt": {"type": "string", "format": "date-time"},
    "validUntil": {"type": "string", "format": "date-time"},
    "issuer": {"$ref": "#/$defs/issuer"},
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "allOf": [
    {
      "if": {"properties": {"disposition": {"enum": ["accepted", "rejected"]}}, "required": ["disposition"]},
      "then": {
        "required": ["wardenDecisionRef", "riverosEvidenceEventRef"],
        "properties": {"humanReviewed": {"const": true}}
      }
    },
    {
      "if": {"properties": {"disposition": {"const": "accepted"}}, "required": ["disposition"]},
      "then": {
        "properties": {
          "evidenceSufficiency": {"const": "sufficient"},
          "permissionCheck": {"enum": ["passed", "conditional"]}
        }
      }
    }
  ],
  "$defs": {
    "issuer": {"type": "object", "additionalProperties": false, "required": ["issuerId", "name"], "properties": {"issuerId": {"type": "string", "minLength": 3, "maxLength": 200}, "name": {"type": "string", "minLength": 1, "maxLength": 240}, "authorityRef": {"type": "string", "maxLength": 1000}}},
    "provenance": {"type": "object", "additionalProperties": false, "properties": {"previousVersionRef": {"type": "string", "maxLength": 500}, "sourceRecordRefs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 3, "maxLength": 1000}}, "changeReason": {"type": "string", "maxLength": 3000}}}
  }
}
