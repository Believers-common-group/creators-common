{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://creators-common.org/schemas/creation-claim.schema.json",
  "title": "Creators Common Creation Claim",
  "description": "A bounded technical, scientific, commercial, circularity or performance claim linked to evidence and validation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "creationClaimId", "recordVersion", "assetDraftId", "statement", "claimType", "status", "ownerCreatorId", "issuer", "createdAt", "updatedAt"],
  "properties": {
    "schemaVersion": {"type": "string", "const": "0.1.0"},
    "creationClaimId": {"type": "string", "pattern": "^CC-CL-[A-Z0-9][A-Z0-9._-]{5,95}$"},
    "recordVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"},
    "assetDraftId": {"type": "string", "minLength": 3, "maxLength": 200},
    "subjectRefs": {"$ref": "#/$defs/idList"},
    "statement": {"type": "string", "minLength": 10, "maxLength": 5000},
    "claimType": {"type": "string", "enum": ["functional", "performance", "scientific", "safety", "quality", "cost", "environmental", "circularity", "compatibility", "commercial", "other"]},
    "status": {"type": "string", "enum": ["draft", "proposed", "supported", "verified", "validated", "rejected", "withdrawn", "superseded", "disputed"]},
    "ownerCreatorId": {"type": "string", "minLength": 3, "maxLength": 200},
    "supportingValidationRefs": {"$ref": "#/$defs/idList"},
    "evidenceRefs": {"$ref": "#/$defs/references"},
    "limitations": {"type": "string", "maxLength": 5000},
    "applicableConditions": {"type": "array", "maxItems": 500, "items": {"type": "string", "minLength": 3, "maxLength": 1000}},
    "excludedUses": {"type": "array", "maxItems": 500, "items": {"type": "string", "minLength": 3, "maxLength": 1000}},
    "reviewerRef": {"type": "string", "maxLength": 200},
    "reviewDecisionRef": {"$ref": "#/$defs/reference"},
    "issuer": {"$ref": "#/$defs/issuer"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "idList": {"type": "array", "uniqueItems": true, "maxItems": 5000, "items": {"type": "string", "minLength": 3, "maxLength": 200}},
    "reference": {"type": "object", "additionalProperties": false, "required": ["ref"], "properties": {"ref": {"type": "string", "minLength": 1, "maxLength": 1000}, "label": {"type": "string", "maxLength": 240}, "hash": {"type": "string", "maxLength": 256}, "mediaType": {"type": "string", "maxLength": 120}, "visibility": {"type": "string", "enum": ["public", "member", "restricted", "confidential"]}}},
    "references": {"type": "array", "maxItems": 5000, "items": {"$ref": "#/$defs/reference"}},
    "issuer": {"type": "object", "additionalProperties": false, "required": ["issuerId", "name"], "properties": {"issuerId": {"type": "string", "minLength": 3, "maxLength": 200}, "name": {"type": "string", "minLength": 1, "maxLength": 240}, "authorityRef": {"type": "string", "maxLength": 500}}},
    "provenance": {"type": "object", "additionalProperties": false, "properties": {"previousVersionRef": {"type": "string", "maxLength": 500}, "sourceRecordRefs": {"$ref": "#/$defs/references"}, "changeReason": {"type": "string", "maxLength": 3000}}}
  }
}
