{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://creators-common.org/schemas/warden-access-policy.schema.json",
  "title": "Creators Common Warden Access Policy",
  "description": "Field-level access, purpose, context, obligations and conflict-resolution rules enforced by Warden for governed Creators Common records.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "accessPolicyId",
    "recordVersion",
    "name",
    "status",
    "defaultEffect",
    "conflictResolution",
    "rules",
    "issuer",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.1.0"
    },
    "accessPolicyId": {
      "type": "string",
      "pattern": "^CC-WA-[A-Z0-9][A-Z0-9._-]{5,95}$"
    },
    "recordVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"
    },
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 240
    },
    "description": {
      "type": "string",
      "maxLength": 5000
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "suspended",
        "superseded",
        "withdrawn"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recordTypes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          }
        },
        "recordRefs": {
          "$ref": "#/$defs/idList"
        },
        "fieldPaths": {
          "$ref": "#/$defs/fieldPaths"
        },
        "classifications": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "public",
              "member",
              "restricted",
              "confidential",
              "secret"
            ]
          }
        }
      }
    },
    "defaultEffect": {
      "type": "string",
      "enum": [
        "permit",
        "deny"
      ]
    },
    "conflictResolution": {
      "type": "string",
      "enum": [
        "deny-overrides",
        "permit-overrides",
        "first-applicable",
        "only-one-applicable"
      ]
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ruleId",
          "effect",
          "actions",
          "priority"
        ],
        "properties": {
          "ruleId": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9._-]{2,119}$"
          },
          "description": {
            "type": "string",
            "maxLength": 3000
          },
          "effect": {
            "type": "string",
            "enum": [
              "permit",
              "deny",
              "permit-with-conditions"
            ]
          },
          "actions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "discover",
                "view",
                "read",
                "write",
                "annotate",
                "export",
                "decrypt",
                "share",
                "sign",
                "review",
                "approve",
                "revoke",
                "delete"
              ]
            }
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "subjectConditions": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "subjectRefs": {
                "$ref": "#/$defs/idList"
              },
              "roles": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 160
                }
              },
              "affiliationRefs": {
                "$ref": "#/$defs/idList"
              },
              "assuranceLevels": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": [
                    "anonymous",
                    "self-asserted",
                    "verified",
                    "strong",
                    "hardware-bound"
                  ]
                }
              }
            }
          },
          "resourceConditions": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "recordTypes": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 120
                }
              },
              "recordRefs": {
                "$ref": "#/$defs/idList"
              },
              "fieldPaths": {
                "$ref": "#/$defs/fieldPaths"
              },
              "classifications": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": [
                    "public",
                    "member",
                    "restricted",
                    "confidential",
                    "secret"
                  ]
                }
              }
            }
          },
          "contextConditions": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "purposes": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 200
                }
              },
              "environments": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": [
                    "public-web",
                    "member-portal",
                    "asset-lab",
                    "laboratory",
                    "factory",
                    "mobile",
                    "api",
                    "administration"
                  ]
                }
              },
              "jurisdictions": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 120
                }
              },
              "networkZones": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 120
                }
              },
              "minimumDeviceTrust": {
                "type": "string",
                "enum": [
                  "unknown",
                  "basic",
                  "managed",
                  "attested",
                  "hardware-bound"
                ]
              },
              "validFrom": {
                "type": "string",
                "format": "date-time"
              },
              "validUntil": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "obligations": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/$defs/obligation"
            }
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reviewFrequencyDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650
        },
        "nextReviewAt": {
          "type": "string",
          "format": "date-time"
        },
        "reviewerRefs": {
          "$ref": "#/$defs/idList"
        }
      }
    },
    "issuer": {
      "$ref": "#/$defs/issuer"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "idList": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 5000,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 200
      }
    },
    "fieldPaths": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 5000,
      "items": {
        "type": "string",
        "pattern": "^\\$?(?:\\.[A-Za-z0-9_-]+|\\[[0-9*]+\\])+$"
      }
    },
    "obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "log-access",
            "riveros-evidence",
            "human-approval",
            "redact-fields",
            "watermark",
            "expiry",
            "purpose-binding",
            "no-export",
            "no-derivative",
            "notify-custodian",
            "custom"
          ]
        },
        "fieldPaths": {
          "$ref": "#/$defs/fieldPaths"
        },
        "approvalRefs": {
          "$ref": "#/$defs/idList"
        },
        "destinationRef": {
          "type": "string",
          "maxLength": 1000
        },
        "expiresAfterSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "details": {
          "type": "string",
          "maxLength": 3000
        }
      }
    },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuerId",
        "name"
      ],
      "properties": {
        "issuerId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "authorityRef": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "previousVersionRef": {
          "type": "string",
          "maxLength": 500
        },
        "sourceRecordRefs": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "changeReason": {
          "type": "string",
          "maxLength": 3000
        }
      }
    }
  }
}
