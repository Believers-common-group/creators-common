{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://creators-common.org/schemas/asset-component.schema.json",
  "title": "Creators Common Asset Component",
  "description": "A component, assembly, module, panel, ingredient group or logical sub-unit within an Asset Draft.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "assetComponentId", "recordVersion", "assetDraftId", "name", "componentType", "quantity", "status", "issuer", "createdAt", "updatedAt"],
  "properties": {
    "schemaVersion": {"type": "string", "const": "0.1.0"},
    "assetComponentId": {"type": "string", "pattern": "^CC-AC-[A-Z0-9][A-Z0-9._-]{5,95}$"},
    "recordVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"},
    "assetDraftId": {"type": "string", "minLength": 3, "maxLength": 200},
    "name": {"type": "string", "minLength": 1, "maxLength": 300},
    "componentType": {"type": "string", "enum": ["assembly", "part", "material-layer", "ingredient-group", "panel", "trim", "electronic-module", "software-module", "workflow-node", "other"]},
    "description": {"type": "string", "maxLength": 5000},
    "parentComponentRef": {"type": "string", "maxLength": 200},
    "childComponentRefs": {"$ref": "#/$defs/idList"},
    "quantity": {"type": "object", "additionalProperties": false, "required": ["value", "unit"], "properties": {"value": {"type": "string", "minLength": 1, "maxLength": 80}, "unit": {"type": "string", "minLength": 1, "maxLength": 80}, "tolerance": {"type": "string", "maxLength": 120}}},
    "materialSpecificationRefs": {"$ref": "#/$defs/idList"},
    "processRecipeRefs": {"$ref": "#/$defs/idList"},
    "interfaceRefs": {"$ref": "#/$defs/references"},
    "supplierEligibility": {"type": "array", "maxItems": 500, "items": {"type": "object", "additionalProperties": false, "required": ["supplierRef", "status"], "properties": {"supplierRef": {"type": "string", "minLength": 3, "maxLength": 300}, "status": {"type": "string", "enum": ["proposed", "approved", "conditional", "suspended", "rejected"]}, "evidenceRefs": {"$ref": "#/$defs/references"}}}},
    "status": {"type": "string", "enum": ["draft", "active", "deprecated", "superseded", "withdrawn"]},
    "issuer": {"$ref": "#/$defs/issuer"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "idList": {"type": "array", "uniqueItems": true, "maxItems": 5000, "items": {"type": "string", "minLength": 3, "maxLength": 200}},
    "reference": {"type": "object", "additionalProperties": false, "required": ["ref"], "properties": {"ref": {"type": "string", "minLength": 1, "maxLength": 1000}, "label": {"type": "string", "maxLength": 240}, "hash": {"type": "string", "maxLength": 256}, "mediaType": {"type": "string", "maxLength": 120}, "visibility": {"type": "string", "enum": ["public", "member", "restricted", "confidential"]}}},
    "references": {"type": "array", "maxItems": 2000, "items": {"$ref": "#/$defs/reference"}},
    "issuer": {"type": "object", "additionalProperties": false, "required": ["issuerId", "name"], "properties": {"issuerId": {"type": "string", "minLength": 3, "maxLength": 200}, "name": {"type": "string", "minLength": 1, "maxLength": 240}, "authorityRef": {"type": "string", "maxLength": 500}}},
    "provenance": {"type": "object", "additionalProperties": false, "properties": {"previousVersionRef": {"type": "string", "maxLength": 500}, "sourceRecordRefs": {"$ref": "#/$defs/references"}, "changeReason": {"type": "string", "maxLength": 3000}}}
  }
}
