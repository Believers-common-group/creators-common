{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://creators-common.org/schemas/synnergyze-asset-operation.schema.json",
  "title": "Synnergyze Asset Operation",
  "description": "A durable, idempotent client operation submitted against a specific Asset Draft revision.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operationId", "recordVersion", "clientOperationId", "idempotencyKey", "sessionRef", "assetDraftId", "actorId", "baseRevision", "operationType", "patches", "status", "occurredAt", "submittedAt", "issuer"],
  "properties": {
    "schemaVersion": {"type": "string", "const": "0.1.0"},
    "operationId": {"type": "string", "pattern": "^CC-SY-OP-[A-Z0-9][A-Z0-9._-]{5,95}$"},
    "recordVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"},
    "clientOperationId": {"type": "string", "minLength": 8, "maxLength": 200},
    "idempotencyKey": {"type": "string", "minLength": 16, "maxLength": 200},
    "sessionRef": {"type": "string", "pattern": "^CC-SY-CS-[A-Z0-9][A-Z0-9._-]{5,95}$"},
    "assetDraftId": {"type": "string", "pattern": "^CC-AD-[A-Z0-9][A-Z0-9._-]{5,95}$"},
    "actorId": {"type": "string", "minLength": 3, "maxLength": 200},
    "baseRevision": {"type": "integer", "minimum": 0},
    "operationType": {"type": "string", "enum": ["patch", "attach-evidence", "link-record", "request-review", "request-release", "resolve-conflict"]},
    "patches": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["op", "path"],
        "properties": {
          "op": {"type": "string", "enum": ["add", "replace", "remove", "move", "test"]},
          "path": {"type": "string", "pattern": "^/(?:[^~/]|~0|~1)*(?:/(?:[^~/]|~0|~1)*)*$", "maxLength": 1000},
          "from": {"type": "string", "pattern": "^/(?:[^~/]|~0|~1)*(?:/(?:[^~/]|~0|~1)*)*$", "maxLength": 1000},
          "value": {}
        },
        "allOf": [
          {"if": {"properties": {"op": {"enum": ["add", "replace", "test"]}}, "required": ["op"]}, "then": {"required": ["value"]}},
          {"if": {"properties": {"op": {"const": "move"}}, "required": ["op"]}, "then": {"required": ["from"]}}
        ]
      }
    },
    "recordRefs": {"type": "array", "uniqueItems": true, "maxItems": 500, "items": {"type": "string", "minLength": 3, "maxLength": 200}},
    "status": {"type": "string", "enum": ["submitted", "accepted", "rejected", "conflicted"]},
    "resultingRevision": {"type": "integer", "minimum": 1},
    "conflictRef": {"type": "string", "maxLength": 200},
    "reasonCodes": {"type": "array", "uniqueItems": true, "maxItems": 100, "items": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{1,95}$"}},
    "occurredAt": {"type": "string", "format": "date-time"},
    "submittedAt": {"type": "string", "format": "date-time"},
    "issuer": {"$ref": "#/$defs/issuer"}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "accepted"}}, "required": ["status"]}, "then": {"required": ["resultingRevision"]}},
    {"if": {"properties": {"status": {"const": "conflicted"}}, "required": ["status"]}, "then": {"required": ["conflictRef", "reasonCodes"]}}
  ],
  "$defs": {
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuerId", "name"],
      "properties": {
        "issuerId": {"type": "string", "minLength": 3, "maxLength": 200},
        "name": {"type": "string", "minLength": 1, "maxLength": 240},
        "authorityRef": {"type": "string", "maxLength": 500}
      }
    }
  }
}
