{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://creators-common.org/schemas/licence-record.schema.json",
  "title": "Creators Common Licence Record",
  "description": "A machine-readable record of permission, field of use, territory, obligations, restrictions, economic terms and lifecycle controls for a registered creation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "licenceId",
    "recordVersion",
    "creationId",
    "family",
    "status",
    "licensor",
    "licensees",
    "permittedActions",
    "prohibitedUses",
    "effectiveFrom",
    "issuer",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.1.0"
    },
    "licenceId": {
      "type": "string",
      "pattern": "^CC-LR-[A-Z0-9][A-Z0-9._-]{5,95}$"
    },
    "recordVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"
    },
    "creationId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    },
    "creationVersionRef": {
      "type": "string",
      "maxLength": 200
    },
    "family": {
      "type": "string",
      "enum": [
        "CC-Open-Knowledge",
        "CC-Research",
        "CC-Commercial-Use",
        "CC-Manufacturing",
        "CC-Deployment",
        "CC-Network",
        "CC-Derivative",
        "CC-Restricted",
        "custom"
      ]
    },
    "customFamilyName": {
      "type": "string",
      "maxLength": 200
    },
    "status": {
      "type": "string",
      "enum": ["draft", "proposed", "active", "suspended", "expired", "terminated", "revoked", "superseded", "disputed"]
    },
    "licensor": {"$ref": "#/$defs/party"},
    "licensees": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/party"}
    },
    "beneficiaryRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 3, "maxLength": 200}
    },
    "effectiveFrom": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "renewal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {"type": "string", "enum": ["none", "manual", "automatic", "performance-gated", "review-gated"]},
        "noticeDays": {"type": "integer", "minimum": 0, "maximum": 3650},
        "maximumRenewals": {"type": "integer", "minimum": 0},
        "conditions": {"type": "string", "maxLength": 5000}
      }
    },
    "territory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope": {"type": "string", "enum": ["worldwide", "countries", "states-regions", "sites", "digital-network", "custom"]},
        "included": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 240}
        },
        "excluded": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 240}
        },
        "description": {"type": "string", "maxLength": 3000}
      }
    },
    "fieldOfUse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "included": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 2, "maxLength": 300}
        },
        "excluded": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 2, "maxLength": 300}
        },
        "intendedUseStatement": {"type": "string", "maxLength": 5000},
        "regulatedUseStatus": {"type": "string", "enum": ["not-applicable", "not-authorised", "research-only", "conditionally-authorised", "authorised", "jurisdiction-dependent"]}
      }
    },
    "permittedActions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "view",
          "evaluate",
          "research",
          "reproduce",
          "modify",
          "create-derivatives",
          "manufacture",
          "deploy",
          "operate",
          "distribute",
          "sublicense",
          "commercialise",
          "train",
          "publish-results",
          "archive"
        ]
      }
    },
    "prohibitedUses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "description"],
        "properties": {
          "code": {"type": "string", "minLength": 2, "maxLength": 100},
          "description": {"type": "string", "minLength": 3, "maxLength": 3000},
          "policyRef": {"type": "string", "maxLength": 1000}
        }
      }
    },
    "volumeLimits": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric", "period", "limit"],
        "properties": {
          "metric": {"type": "string", "minLength": 1, "maxLength": 120},
          "period": {"type": "string", "enum": ["transaction", "day", "month", "quarter", "year", "term", "site", "user", "device", "batch"]},
          "limit": {"type": "number", "minimum": 0},
          "unit": {"type": "string", "maxLength": 80},
          "overagePolicy": {"type": "string", "maxLength": 3000}
        }
      }
    },
    "sites": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["siteId", "status"],
        "properties": {
          "siteId": {"type": "string", "minLength": 2, "maxLength": 200},
          "name": {"type": "string", "maxLength": 240},
          "status": {"type": "string", "enum": ["proposed", "approved", "suspended", "removed"]},
          "approvedAt": {"type": "string", "format": "date-time"}
        }
      }
    },
    "evidenceObligations": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event", "requiredRecord", "retentionPeriod"],
        "properties": {
          "event": {"type": "string", "minLength": 2, "maxLength": 200},
          "requiredRecord": {"type": "string", "minLength": 2, "maxLength": 300},
          "destinationRef": {"type": "string", "maxLength": 1000},
          "retentionPeriod": {"type": "string", "minLength": 1, "maxLength": 120},
          "submissionDeadline": {"type": "string", "maxLength": 120}
        }
      }
    },
    "reporting": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "frequency": {"type": "string", "enum": ["none", "per-use", "daily", "weekly", "monthly", "quarterly", "annually", "on-request", "event-driven"]},
        "requiredMetrics": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 160}
        },
        "reportingEndpointRef": {"type": "string", "maxLength": 1000},
        "auditRight": {"type": "boolean"},
        "auditTerms": {"type": "string", "maxLength": 5000}
      }
    },
    "economicTerms": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "upfrontFee": {"type": "number", "minimum": 0},
        "recurringFee": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "amount": {"type": "number", "minimum": 0},
            "period": {"type": "string", "enum": ["month", "quarter", "year", "term"]}
          }
        },
        "royalties": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["basis", "rateType", "rate", "beneficiaryRef"],
            "properties": {
              "basis": {"type": "string", "enum": ["gross-revenue", "net-revenue", "unit", "usage", "licence-fee", "milestone", "custom"]},
              "rateType": {"type": "string", "enum": ["percentage", "fixed", "tiered"]},
              "rate": {"type": "number", "minimum": 0},
              "unit": {"type": "string", "maxLength": 100},
              "beneficiaryRef": {"type": "string", "minLength": 3, "maxLength": 200},
              "terms": {"type": "string", "maxLength": 3000}
            }
          }
        },
        "taxTreatment": {"type": "string", "maxLength": 3000},
        "paymentTerms": {"type": "string", "maxLength": 5000}
      }
    },
    "derivativeTerms": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "permitted": {"type": "boolean"},
        "registrationRequired": {"type": "boolean"},
        "attributionRequired": {"type": "boolean"},
        "shareAlike": {"type": "boolean"},
        "approvalRequired": {"type": "boolean"},
        "economicParticipation": {"type": "string", "maxLength": 3000},
        "lineageRequirements": {"type": "string", "maxLength": 3000}
      }
    },
    "sublicensing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "permitted": {"type": "boolean"},
        "approvalRequired": {"type": "boolean"},
        "flowDownRequired": {"type": "boolean"},
        "terms": {"type": "string", "maxLength": 5000}
      }
    },
    "compliance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requiredStandards": {"$ref": "#/$defs/references"},
        "requiredApprovals": {"$ref": "#/$defs/references"},
        "trainingRequirements": {"type": "string", "maxLength": 5000},
        "insuranceRequirements": {"type": "string", "maxLength": 3000},
        "dataProtectionRequirements": {"type": "string", "maxLength": 5000}
      }
    },
    "suspension": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "automaticTriggers": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 3, "maxLength": 500}
        },
        "wardenPolicyRef": {"type": "string", "maxLength": 1000},
        "curePeriodDays": {"type": "integer", "minimum": 0, "maximum": 3650},
        "appealProcessRef": {"type": "string", "maxLength": 1000},
        "effect": {"type": "string", "maxLength": 3000}
      }
    },
    "termination": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "terminationRights": {"type": "string", "maxLength": 5000},
        "postTerminationObligations": {"type": "string", "maxLength": 5000},
        "survivingTerms": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 2, "maxLength": 200}
        }
      }
    },
    "governingTerms": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agreementRef": {"$ref": "#/$defs/reference"},
        "governingLaw": {"type": "string", "maxLength": 240},
        "jurisdiction": {"type": "string", "maxLength": 240},
        "disputeResolution": {"type": "string", "maxLength": 5000},
        "orderOfPrecedence": {"type": "string", "maxLength": 3000}
      }
    },
    "issuer": {"$ref": "#/$defs/issuer"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"family": {"const": "custom"}},
        "required": ["family"]
      },
      "then": {
        "required": ["customFamilyName"]
      }
    }
  ],
  "$defs": {
    "party": {
      "type": "object",
      "additionalProperties": false,
      "required": ["partyId", "name", "partyType"],
      "properties": {
        "partyId": {"type": "string", "minLength": 3, "maxLength": 200},
        "name": {"type": "string", "minLength": 1, "maxLength": 300},
        "partyType": {"type": "string", "enum": ["person", "institution", "collective", "public-body"]},
        "authorityRef": {"type": "string", "maxLength": 1000}
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref"],
      "properties": {
        "ref": {"type": "string", "minLength": 1, "maxLength": 1000},
        "label": {"type": "string", "maxLength": 240},
        "hash": {"type": "string", "maxLength": 256},
        "mediaType": {"type": "string", "maxLength": 120},
        "visibility": {"type": "string", "enum": ["public", "member", "restricted", "confidential"]}
      }
    },
    "references": {
      "type": "array",
      "maxItems": 2000,
      "items": {"$ref": "#/$defs/reference"}
    },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuerId", "name"],
      "properties": {
        "issuerId": {"type": "string", "minLength": 3, "maxLength": 200},
        "name": {"type": "string", "minLength": 1, "maxLength": 240},
        "authorityRef": {"type": "string", "maxLength": 500}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "previousVersionRef": {"type": "string", "maxLength": 500},
        "sourceRecordRefs": {"$ref": "#/$defs/references"},
        "contentHash": {"type": "string", "maxLength": 256},
        "signatureRef": {"type": "string", "maxLength": 1000},
        "changeReason": {"type": "string", "maxLength": 3000}
      }
    }
  }
}
