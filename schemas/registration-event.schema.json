{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://creators-common.org/schemas/registration-event.schema.json",
  "title": "Creators Common Registration Event",
  "description": "Append-only event for Creator and Creation registration workflow state transitions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "recordVersion",
    "applicationRef",
    "applicationType",
    "sequence",
    "eventType",
    "status",
    "actor",
    "reasonCodes",
    "publicProjectionEffect",
    "riverosEvidenceEventRef",
    "occurredAt",
    "issuer"
  ],
  "properties": {
    "schemaVersion": {"type": "string", "const": "0.1.0"},
    "eventId": {"type": "string", "pattern": "^CC-REG-EV-[A-Z0-9][A-Z0-9._-]{5,95}$"},
    "recordVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"},
    "applicationRef": {"type": "string", "minLength": 3, "maxLength": 200},
    "applicationType": {"type": "string", "enum": ["creator", "creation"]},
    "sequence": {"type": "integer", "minimum": 1},
    "previousEventRef": {"type": "string", "maxLength": 200},
    "eventType": {"type": "string", "enum": ["submitted", "evidence-attached", "review-started", "returned", "accepted", "rejected", "passport-issued", "withdrawn", "superseded"]},
    "status": {"type": "string", "enum": ["proposed", "applied", "rejected", "superseded"]},
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actorRef", "role"],
      "properties": {
        "actorRef": {"type": "string", "minLength": 3, "maxLength": 200},
        "role": {"type": "string", "enum": ["applicant", "reviewer", "registration-authority", "warden", "system"]}
      }
    },
    "reviewRef": {"type": "string", "maxLength": 200},
    "outputPassportRef": {"type": "string", "maxLength": 200},
    "wardenDecisionRef": {"type": "string", "maxLength": 200},
    "reasonCodes": {"type": "array", "minItems": 1, "uniqueItems": true, "maxItems": 100, "items": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{1,95}$"}},
    "publicProjectionEffect": {"type": "string", "enum": ["none", "prepare-eligible", "remove"]},
    "riverosEvidenceEventRef": {"type": "string", "minLength": 3, "maxLength": 200},
    "occurredAt": {"type": "string", "format": "date-time"},
    "effectiveAt": {"type": "string", "format": "date-time"},
    "issuer": {"$ref": "#/$defs/issuer"},
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "allOf": [
    {
      "if": {"properties": {"sequence": {"minimum": 2}}, "required": ["sequence"]},
      "then": {"required": ["previousEventRef"]}
    },
    {
      "if": {"properties": {"eventType": {"enum": ["accepted", "rejected", "passport-issued"]}}, "required": ["eventType"]},
      "then": {"required": ["reviewRef", "wardenDecisionRef"]}
    },
    {
      "if": {"properties": {"eventType": {"const": "passport-issued"}}, "required": ["eventType"]},
      "then": {
        "required": ["outputPassportRef", "effectiveAt"],
        "properties": {"publicProjectionEffect": {"const": "prepare-eligible"}}
      }
    }
  ],
  "$defs": {
    "issuer": {"type": "object", "additionalProperties": false, "required": ["issuerId", "name"], "properties": {"issuerId": {"type": "string", "minLength": 3, "maxLength": 200}, "name": {"type": "string", "minLength": 1, "maxLength": 240}, "authorityRef": {"type": "string", "maxLength": 1000}}},
    "provenance": {"type": "object", "additionalProperties": false, "properties": {"previousVersionRef": {"type": "string", "maxLength": 500}, "sourceRecordRefs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 3, "maxLength": 1000}}, "changeReason": {"type": "string", "maxLength": 3000}}}
  }
}
